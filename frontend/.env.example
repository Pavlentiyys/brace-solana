# Server-only Agent Router credential. Never expose this as NEXT_PUBLIC_ or commit a real key.
# If GEMINI_API_KEY is set, Gemini is used first and Agent Router remains the fallback.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=your-gemini-api-key

AGENT_ROUTER_API_KEY=sk-your-agent-router-key
AGENT_ROUTER_BASE_URL=https://agentrouter.org
AGENT_ROUTER_MODEL=claude-opus-4-8

# Optional compatibility names. The route uses Agent Router variables first.
# ANTHROPIC_AUTH_TOKEN=sk-your-agent-router-key
# ANTHROPIC_API_KEY=sk-your-agent-router-key
# ANTHROPIC_BASE_URL=https://agentrouter.org
# ANTHROPIC_MODEL=claude-opus-4-8
